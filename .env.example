# Домен, A-запись которого указывает на IP вашего VPS (нужен для HTTPS и webhook MAX)
DOMAIN=bot.example.com
# Токен бота из MAX (@MasterBot)
MAX_BOT_TOKEN=
# user_id в MAX для уведомлений о заявках, через запятую (можно пусто)
ADMIN_USER_IDS=
# Ключ шифрования данных n8n — сгенерируется в setup.sh; не менять после первого запуска
N8N_ENCRYPTION_KEY=
TZ=Europe/Moscow
